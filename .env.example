# Never commit real secrets. Add these in Netlify > Project configuration > Environment variables.

# Used to sign OAuth state and encrypt provider tokens before storing them in Netlify Blobs.
# Generate a long random value (32+ bytes recommended).
TOKEN_ENCRYPTION_KEY=

# TikTok for Developers app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta developer app (Facebook + Instagram Professional)
META_APP_ID=
META_APP_SECRET=
# Set this to the Graph API version shown/recommended in your Meta app dashboard, e.g. vXX.X.
META_GRAPH_VERSION=

# Google Cloud OAuth 2.0 Web application (YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Register this exact redirect URI with every provider:
# https://socialmediam.netlify.app/.netlify/functions/oauth-callback
